DB_URL=sqlite:///dashboard.db
APP_ENV=development
CORS_ORIGINS=http://localhost:4200,http://localhost:8000
RATE_LIMIT=60/minute
RATE_LIMIT_ENABLED=true
# Dev default is memory:// when unset. Production REQUIRES this env
# (redis://… recommended; memory:// allowed explicitly for single-node).
RATE_LIMIT_STORAGE_URI=memory://
# Production REQUIRES non-empty comma-separated proxy IPs (no '*').
TRUSTED_PROXIES=
LOG_JSON=false

HSTS_ENABLED=false

# Authentication
JWT_SECRET_KEY=dev-only-change-me-use-openssl-rand-hex-32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_COOKIE_SECURE=false
AUTH_ENABLED=true

# Tenant credentials encryption (required in production; openssl rand -hex 32)
CREDENTIALS_ENCRYPTION_KEY=

# iiko sync: never enable embedded worker / in-API sync in production
SYNC_EMBEDDED_WORKER=false
# Production must set false (API only enqueues; worker drains the queue)
SYNC_RUN_IN_API=true
# Production REQUIRES ≥32 chars, non-placeholder (openssl rand -hex 32)
SYNC_SCHEDULER_TOKEN=your-long-random-secret-at-least-16-chars
